# Copy this file to .env and edit the values for your machine.

# Local Hugging Face-compatible Llama 8B checkpoint.
LLAMA_MODEL_PATH=

# Physical GPU IDs exposed to this notebook process.
CUDA_VISIBLE_DEVICES=0

# Device index within the visible set. The first visible GPU is cuda:0.
PROFILE_DEVICE=cuda:0

# Output paths are resolved relative to the week1 directory.
PROFILE_OUTPUT_DIR=profile-results

# Profiling parameters.
PROFILE_DTYPE=bfloat16
LLAMA_ATTN_IMPLEMENTATION=sdpa
PROFILE_BATCH_SIZE=1
PROFILE_SEQUENCE_LENGTHS=128,512,1024
PROFILE_WARMUP_STEPS=3
PROFILE_REPEAT_STEPS=10
